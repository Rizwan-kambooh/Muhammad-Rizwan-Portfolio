{
  "rewrites": [
    {
      "source": "/admin-login",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}
      ]
    },
    {
      "source": "/admin-login",
      "headers": [
        {"key": "X-Robots-Tag", "value": "noindex, nofollow"}
      ]
    }
  ]
}
